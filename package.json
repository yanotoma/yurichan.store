  "bugs": {
    "url": "https://github.com/yanotoma/yurichan.store/issues"
  },
  "homepage": "https://github.com/yanotoma/yurichan.store#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.0.0"
  }
}
