{
  "name": "yurichan.store",
  "version": "1.0.0",
  "description": "[![Build status](https://github.com/shopify/dawn/actions/workflows/ci.yml/badge.svg?branch=main)](https://github.com/Shopify/dawn/actions/workflows/ci.yml?query=branch%3Amain) [![PRs Welcome](https://img.shields.io/badge/PRs-welcome-brightgreen.svg?color=informational)](/.github/CONTRIBUTING.md)",
  "main": "index.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./assets/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./assets/tailwind.css --watch",
    "dev": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./assets/tailwind.css --watch & shopify theme dev --store yurichan.store"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanotoma/yurichan.store.git"
  },
