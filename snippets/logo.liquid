{% comment %}
  Renders the brand logo snippet combining SVG icon and 2-line brand typography.
  Accepts:
  - class: {String} Additional container classes
  - size: {String} 'sm' | 'md' | 'lg' (default: 'md')
{% endcomment %}

{% assign logo_size = size | default: 'md' %}

<a href="/" class="flex items-center gap-2.5 group select-none {{ class }}">
  <img 
    src="{{ 'yurichan-logo.svg' | asset_url }}" 
    alt="{{ shop.name }}" 
    class="{% if logo_size == 'sm' %}h-8{% elsif logo_size == 'lg' %}h-14{% else %}h-10 md:h-12{% endif %} w-auto object-contain transition-transform group-hover:scale-105"
    loading="eager"
  >
  <div class="flex flex-col items-end leading-[0.85] -space-y-1">
    <span class="font-fredoka font-black {% if logo_size == 'sm' %}text-lg{% elsif logo_size == 'lg' %}text-3xl md:text-4xl{% else %}text-2xl md:text-3xl{% endif %} text-yuri-dark tracking-tight uppercase">
      YURICHAN
    </span>
    <span class="font-fredoka font-bold {% if logo_size == 'sm' %}text-[9px]{% elsif logo_size == 'lg' %}text-xs md:text-sm{% else %}text-[11px] md:text-xs{% endif %} text-yuri-dark/70 tracking-widest lowercase">
      .store
    </span>
  </div>
</a>
