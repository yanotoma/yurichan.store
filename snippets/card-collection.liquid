{% comment %}
  Renders a Neo-Brutalist collection card for Yurichan store
  Accepts:
  - card_collection: {Object} Collection Liquid object
{% endcomment %}

{%- liquid
  assign collection_image = card_collection.featured_image
  if collection_image == nil and card_collection.products.first != blank
    if card_collection.products.first.featured_image != nil
      assign collection_image = card_collection.products.first.featured_image
    elsif card_collection.products.first.featured_media != nil
      assign collection_image = card_collection.products.first.featured_media
    endif
  endif
-%}

<div class="neo-card p-4 bg-white border-3 border-yuri-dark shadow-[6px_6px_0px_#2b2b2b] rounded-2xl flex flex-col justify-between hover:bg-yuri-pink/10 transition-all transform hover:-translate-y-1 group">
  <a href="{{ card_collection.url | default: '#' }}" class="block w-full h-full">
    <!-- Media Image Box -->
    <div class="relative w-full aspect-square bg-yuri-bg rounded-xl overflow-hidden border-2 border-yuri-dark mb-4">
      {%- if collection_image -%}
        <img
          src="{{ collection_image | image_url: width: 800 }}"
          alt="{{ collection_image.alt | default: card_collection.title | escape }}"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        >
      {%- else -%}
        <div class="w-full h-full flex flex-col items-center justify-center bg-yuri-lilac/20 text-yuri-dark/60 font-fredoka font-bold text-lg p-4 text-center">
          <span>🐾 {{ card_collection.title | default: 'Collection' }}</span>
        </div>
      {%- endif -%}

      {% if card_collection.products_count != blank and card_collection.products_count > 0 %}
        <span class="absolute top-3 right-3 bg-yuri-yellow text-yuri-dark text-xs font-fredoka font-bold px-2.5 py-1 rounded-full border border-yuri-dark shadow-[2px_2px_0px_#2b2b2b]">
          {{ card_collection.products_count }} Items
        </span>
      {% endif %}
    </div>

    <!-- Collection Details -->
    <div class="flex items-center justify-between gap-2 mt-2">
      <h3 class="font-fredoka font-bold text-xl text-yuri-dark group-hover:text-yuri-lilac transition-colors">
        {{ card_collection.title | default: 'Featured Collection' }}
      </h3>
      <span class="neo-button text-xs py-1 px-3 font-bold">
        View →
      </span>
    </div>
  </a>
</div>
