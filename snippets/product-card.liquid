{% comment %}
  Renders a product card in Kawaii Neo-Brutalist style.
  Accepts:
  - card_product: {Object} Product Liquid object
{% endcomment %}

{% assign is_spooky = false %}
{% assign lower_title = card_product.title | downcase %}
{% if collection.handle == 'pet-halloween' or card_product.tags contains 'Halloween' or card_product.tags contains 'halloween' or lower_title contains 'halloween' or lower_title contains 'spooky' %}
  {% assign is_spooky = true %}
{% endif %}

<div class="neo-card flex flex-col justify-between h-full p-4 group {% if is_spooky %}bg-[#1d0e2e] border-white text-white shadow-[4px_4px_0px_#ff7a00] hover:shadow-[6px_6px_0px_#ff7a00] hover:-translate-y-0.5{% else %}bg-white border-yuri-dark text-yuri-dark hover:shadow-[6px_6px_0px_#2b2b2b] hover:-translate-y-0.5{% endif %} transition-all">
  <div class="flex flex-col gap-3">
    <!-- Image -->
    <a href="{{ card_product.url }}" class="block overflow-hidden rounded-xl border-2 {% if is_spooky %}border-[#ff7a00] bg-[#12071f]{% else %}border-yuri-dark bg-yuri-bg{% endif %} aspect-square relative">
      {% if card_product.featured_media %}
        <img 
          src="{{ card_product.featured_media | image_url: width: 500 }}" 
          alt="{{ card_product.featured_media.alt | escape }}"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        >
      {% else %}
        <div class="w-full h-full flex items-center justify-center {% if is_spooky %}text-white/40{% else %}text-yuri-dark/40{% endif %} font-fredoka">
          No Image
        </div>
      {% endif %}

      {% if card_product.compare_at_price > card_product.price %}
        <span class="neo-badge {% if is_spooky %}bg-[#ff7a00] text-white border-white shadow-[2px_2px_0px_#ffffff]{% else %}bg-yuri-pink text-yuri-dark border-yuri-dark{% endif %} text-xs absolute top-2 right-2 px-2 py-0.5">
          Sale
        </span>
      {% endif %}
    </a>

    <!-- Info -->
    <div>
      {% if card_product.category %}
        <span class="inline-block text-[11px] font-fredoka font-bold {% if is_spooky %}text-gray-400{% else %}text-yuri-dark/60{% endif %} uppercase tracking-wider mb-0.5">
          {{ card_product.category.name }}
        </span>
      {% endif %}
      <h3 class="font-fredoka font-bold text-lg {% if is_spooky %}text-white{% else %}text-yuri-dark{% endif %} line-clamp-2 mt-0.5">
        <a href="{{ card_product.url }}" class="hover:underline">
          {{ card_product.title }}
        </a>
      </h3>
    </div>
  </div>

  <!-- Price & Action -->
  <div class="flex items-center justify-between mt-4 pt-3 border-t-2 {% if is_spooky %}border-white/10{% else %}border-yuri-dark/10{% endif %}">
    <div class="flex items-baseline gap-1.5 font-fredoka font-bold">
      <span class="text-xl {% if is_spooky %}text-[#ff7a00]{% else %}text-yuri-dark{% endif %}">
        {% if settings.currency_code_enabled %}
          {{ card_product.price | money_with_currency }}
        {% else %}
          {{ card_product.price | money }}
        {% endif %}
      </span>
      {% if card_product.compare_at_price > card_product.price %}
        <span class="text-sm {% if is_spooky %}text-white/40{% else %}text-yuri-dark/40{% endif %} line-through">
          {% if settings.currency_code_enabled %}
            {{ card_product.compare_at_price | money_with_currency }}
          {% else %}
            {{ card_product.compare_at_price | money }}
          {% endif %}
        </span>
      {% endif %}
    </div>

    <!-- View Button -->
    <a href="{{ card_product.url }}" class="font-fredoka font-bold text-xs py-2 px-4 rounded-full border-2 transition-colors {% if is_spooky %}bg-[#ff7a00] hover:bg-[#ff9500] text-[#12071f] border-white shadow-[2px_2px_0px_#ffffff]{% else %}bg-yuri-lilac text-yuri-dark border-yuri-dark hover:bg-yuri-pink{% endif %}">
      View
    </a>
  </div>
</div>
