{% comment %}
  Renders a product card in Kawaii Neo-Brutalist style.
  Accepts:
  - card_product: {Object} Product Liquid object
{% endcomment %}

<div class="neo-card neo-card-hover flex flex-col justify-between h-full bg-white p-4 group">
  <div class="flex flex-col gap-3">
    <!-- Image -->
    <a href="{{ card_product.url }}" class="block overflow-hidden rounded-xl border-2 border-yuri-dark bg-yuri-bg aspect-square relative">
      {% if card_product.featured_media %}
        <img 
          src="{{ card_product.featured_media | image_url: width: 500 }}" 
          alt="{{ card_product.featured_media.alt | escape }}"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        >
      {% else %}
        <div class="w-full h-full flex items-center justify-center text-yuri-dark/40 font-fredoka">
          No Image
        </div>
      {% endif %}

      {% if card_product.compare_at_price > card_product.price %}
        <span class="neo-badge bg-yuri-pink text-xs absolute top-2 right-2 px-2 py-0.5">
          Sale
        </span>
      {% endif %}
    </a>

    <!-- Info -->
    <div>
      {% if card_product.vendor %}
        <span class="text-xs uppercase font-fredoka font-semibold text-yuri-dark/60 tracking-wider">
          {{ card_product.vendor }}
        </span>
      {% endif %}
      <h3 class="font-fredoka font-bold text-lg text-yuri-dark line-clamp-2 mt-0.5">
        <a href="{{ card_product.url }}" class="hover:underline">
          {{ card_product.title }}
        </a>
      </h3>
    </div>
  </div>

  <!-- Price & Action -->
  <div class="flex items-center justify-between mt-4 pt-3 border-t-2 border-yuri-dark/10">
    <div class="flex items-baseline gap-1.5 font-fredoka font-bold">
      <span class="text-xl text-yuri-dark">
        {{ card_product.price | money }}
      </span>
      {% if card_product.compare_at_price > card_product.price %}
        <span class="text-sm text-yuri-dark/40 line-through">
          {{ card_product.compare_at_price | money }}
        </span>
      {% endif %}
    </div>

    <!-- Clean button without emoji -->
    <a href="{{ card_product.url }}" class="bg-yuri-lilac text-yuri-dark font-fredoka font-bold text-xs py-2 px-4 rounded-full border-2 border-yuri-dark hover:bg-yuri-pink transition-colors">
      View
    </a>
  </div>
</div>
