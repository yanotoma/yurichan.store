<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#faf8ff">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts: Fredoka for Kawaii Titles & Outfit for Body Text -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

    {{ 'tailwind.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="{% if template.name == 'collection' and collection.handle == 'pet-halloween' %}bg-[#121214] text-white{% else %}bg-yuri-bg text-yuri-dark{% endif %} font-outline min-h-screen antialiased">
    <a class="sr-only focus:not-sr-only focus:p-4 focus:bg-yuri-pink focus:text-yuri-dark" href="#MainContent">
      Skip to content
    </a>

    <div class="sticky top-0 z-[9999] relative" style="position: sticky; top: 0; z-index: 9999;">
      {% sections 'header-group' %}
    </div>

    <main id="MainContent" class="grow" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
