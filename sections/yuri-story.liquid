{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and min-width: 750px {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-[rgba(184,167,212,0.25)]">
      <div class="w-full md:w-1/2 space-y-4">
        <span class="inline-block bg-[var(--color-yuri-yellow)] text-[var(--color-yuri-gray)] font-semibold px-4 py-1.5 rounded-full text-xs tracking-wider uppercase">
          Our Heartfelt Story 🐾
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-yuri-gray)] tracking-tight font-['Fredoka']">
          {{ section.settings.heading | escape }}
        </h2>
        <div class="text-[var(--color-yuri-gray)] space-y-4 leading-relaxed font-['Quicksand'] text-base md:text-lg">
          {{ section.settings.story_text }}
        </div>
        {%- if section.settings.button_label != blank -%}
          <div class="pt-4">
            <a href="{{ section.settings.button_link }}" class="inline-flex items-center gap-2 bg-[var(--color-yuri-lilac)] text-white font-medium px-6 py-3 rounded-full hover:opacity-90 transition-opacity">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <div class="w-full md:w-1/2 flex justify-center">
        <div class="relative w-full max-w-md aspect-square rounded-3xl overflow-hidden bg-[var(--color-yuri-bg)] flex items-center justify-center p-6 border border-dashed border-[var(--color-yuri-lilac)]">
          <div class="text-center space-y-3">
            <div class="text-6xl">🐶🐱✨</div>
            <p class="text-[var(--color-yuri-gray)] font-semibold text-lg font-['Fredoka']">Crafted with Love for Yuri & Every Furry Companion</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yuri Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Inspired by Yuri, Made for Your Pets",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "default": "<p>Yuri Chan Store was born out of deep love and devotion. Named after my daughter Yuri, our brand brings that same tender care and affection to pet products worldwide. We believe every pet deserves high-quality, cute, and comfortable essentials that make their days joyful!</p>",
      "label": "Story Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Shop Pet Collection",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Yuri Story"
    }
  ]
}
{% endschema %}
