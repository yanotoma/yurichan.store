<section class="max-w-7xl mx-auto px-4 py-8 md:py-12">
  <div class="neo-card p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 md:gap-12 bg-white">
    <div class="w-full md:w-1/2 space-y-4">
      {% if section.settings.subheading != blank %}
        <span class="neo-badge text-xs uppercase tracking-wider">
          {{ section.settings.subheading | escape }}
        </span>
      {% else %}
        <span class="neo-badge text-xs uppercase tracking-wider">
          Our Heartfelt Story
        </span>
      {% endif %}

      <h2 class="font-fredoka text-3xl md:text-4xl font-extrabold text-yuri-dark tracking-tight">
        {{ section.settings.heading | escape }}
      </h2>

      <div class="text-yuri-dark/90 space-y-4 leading-relaxed font-quicksand text-base md:text-lg font-medium">
        {{ section.settings.story_text }}
      </div>

      {% if section.settings.button_label != blank %}
        <div class="pt-2">
          <a 
            href="{{ section.settings.button_link }}" 
            class="neo-button text-base font-bold inline-flex items-center gap-2"
          >
            {{ section.settings.button_label | escape }} →
          </a>
        </div>
      {% endif %}
    </div>

    {% if section.settings.image != blank %}
      <div class="w-full md:w-1/2">
        <div class="neo-card overflow-hidden p-2 bg-yuri-mint/30">
          <img 
            src="{{ section.settings.image | image_url: width: 800 }}" 
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            class="w-full h-auto object-cover rounded-xl"
            loading="lazy"
          >
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Yuri Story",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Heartfelt Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted with love for your best friends"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Text",
      "default": "<p>Welcome to Yurichan Store! We design high quality, adorable accessories and essentials for your beloved pets.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Yuri Story"
    }
  ]
}
{% endschema %}
