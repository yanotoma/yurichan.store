<section class="max-w-3xl mx-auto px-4 py-8 md:py-12">
  <div class="neo-card p-6 md:p-10 bg-white">
    <span class="neo-badge text-xs uppercase mb-3">
      Get in Touch
    </span>
    <h1 class="font-fredoka text-3xl md:text-5xl font-extrabold text-yuri-dark tracking-tight mb-2">
      {{ section.settings.heading | default: "Contact Us" }}
    </h1>
    <p class="font-outline text-yuri-dark/80 text-base mb-8">
      Have a question or feedback? We'd love to hear from you! Fill out the form below and we'll reply as soon as possible.
    </p>

    {% form 'contact', class: 'space-y-6' %}
      {% if form.posted_successfully? %}
        <div class="neo-card p-4 bg-yuri-mint text-yuri-dark font-fredoka font-bold text-center">
          Thank you for contacting us! We'll get back to you shortly.
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="neo-card p-4 bg-yuri-pink text-yuri-dark font-fredoka font-bold text-center">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label for="ContactForm-name" class="font-fredoka font-bold text-sm text-yuri-dark uppercase">
            Your Name
          </label>
          <input 
            type="text" 
            id="ContactForm-name" 
            name="contact[name]" 
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="Jane Doe"
            required
            class="neo-card w-full py-3 px-4 text-base font-outline text-yuri-dark focus:outline-none focus:ring-2 focus:ring-yuri-lilac"
          >
        </div>

        <div class="space-y-2">
          <label for="ContactForm-email" class="font-fredoka font-bold text-sm text-yuri-dark uppercase">
            Your Email
          </label>
          <input 
            type="email" 
            id="ContactForm-email" 
            name="contact[email]" 
            autocorrect="off" 
            autocapitalize="off" 
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="jane@example.com"
            required
            class="neo-card w-full py-3 px-4 text-base font-outline text-yuri-dark focus:outline-none focus:ring-2 focus:ring-yuri-lilac"
          >
        </div>
      </div>

      <div class="space-y-2">
        <label for="ContactForm-phone" class="font-fredoka font-bold text-sm text-yuri-dark uppercase">
          Phone Number (Optional)
        </label>
        <input 
          type="tel" 
          id="ContactForm-phone" 
          name="contact[phone]" 
          pattern="[0-9\-]*"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          placeholder="+1 (555) 000-0000"
          class="neo-card w-full py-3 px-4 text-base font-outline text-yuri-dark focus:outline-none focus:ring-2 focus:ring-yuri-lilac"
        >
      </div>

      <div class="space-y-2">
        <label for="ContactForm-body" class="font-fredoka font-bold text-sm text-yuri-dark uppercase">
          Message
        </label>
        <textarea 
          rows="5" 
          id="ContactForm-body" 
          name="contact[body]" 
          placeholder="How can we help you and your furry friend?"
          required
          class="neo-card w-full py-3 px-4 text-base font-outline text-yuri-dark focus:outline-none focus:ring-2 focus:ring-yuri-lilac"
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>

      <button type="submit" class="neo-button w-full py-3.5 text-lg font-bold">
        Send Message
      </button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
