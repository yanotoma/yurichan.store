<footer class="bg-white border-t-3 border-yuri-dark mt-16 pt-12 pb-8">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
    <!-- Brand Info -->
    <div class="space-y-4 md:col-span-1">
      <span class="font-fredoka font-extrabold text-2xl text-yuri-dark tracking-tight bg-yuri-pink px-3 py-1 rounded-2xl border-2 border-yuri-dark shadow-[2px_2px_0px_#2b2b2b] inline-block">
        Yurichan🐾
      </span>
      <p class="text-sm font-quicksand text-yuri-dark/80 font-medium leading-relaxed">
        Adorning your best friends with cute, comfy, and safe accessories. Crafted with love.
      </p>
    </div>

    <!-- Quick Links -->
    <div class="space-y-3">
      <h3 class="font-fredoka font-bold text-lg text-yuri-dark">Navigation</h3>
      <ul class="space-y-2 font-quicksand text-sm font-semibold text-yuri-dark/80">
        <li><a href="/" class="hover:text-yuri-lilac">Home</a></li>
        <li><a href="/collections/all" class="hover:text-yuri-lilac">All Products</a></li>
        <li><a href="/pages/about" class="hover:text-yuri-lilac">About Us</a></li>
        <li><a href="/pages/contact" class="hover:text-yuri-lilac">Contact Us</a></li>
      </ul>
    </div>

    <!-- Customer Care -->
    <div class="space-y-3">
      <h3 class="font-fredoka font-bold text-lg text-yuri-dark">Customer Care</h3>
      <ul class="space-y-2 font-quicksand text-sm font-semibold text-yuri-dark/80">
        <li><a href="/policies/shipping-policy" class="hover:text-yuri-lilac">Shipping & Delivery</a></li>
        <li><a href="/policies/refund-policy" class="hover:text-yuri-lilac">Returns & Refunds</a></li>
        <li><a href="/policies/privacy-policy" class="hover:text-yuri-lilac">Privacy Policy</a></li>
        <li><a href="/policies/terms-of-service" class="hover:text-yuri-lilac">Terms of Service</a></li>
        <li><a href="/pages/data-sharing-opt-out" class="hover:text-yuri-lilac">Do Not Sell My Data (Opt-Out)</a></li>
      </ul>
    </div>

    <!-- Newsletter -->
    <div class="space-y-3">
      <h3 class="font-fredoka font-bold text-lg text-yuri-dark">Join the Family 🐾</h3>
      <p class="text-xs text-yuri-dark/80 font-quicksand">Get exclusive deals and cute new arrivals.</p>
      {% form 'customer', class: 'flex flex-col gap-2' %}
        <input 
          type="email" 
          name="contact[email]" 
          placeholder="your-email@example.com"
          required
          class="neo-card py-2 px-3 text-sm font-quicksand text-yuri-dark focus:outline-none focus:ring-2 focus:ring-yuri-lilac"
        >
        <button type="submit" class="neo-button py-2 text-sm font-bold w-full">
          Subscribe
        </button>
      {% endform %}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 pt-6 border-t-2 border-yuri-dark/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-quicksand font-bold text-yuri-dark/60">
    <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
    <div class="flex gap-4">
      <span>Visa</span>
      <span>Mastercard</span>
      <span>PayPal</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
