<header class="bg-white border-b-3 border-yuri-dark sticky top-0 z-40 shadow-[0_4px_0_#2b2b2b]">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <!-- Mobile Drawer Toggle Button -->
      <button 
        type="button" 
        class="md:hidden p-2 text-yuri-dark hover:text-yuri-lilac focus:outline-none"
        onclick="document.getElementById('MobileMenuDrawer').classList.toggle('hidden')"
        aria-label="Toggle Mobile Menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-7 h-7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <!-- Reusable Logo Component -->
      {% render 'logo', size: 'md' %}
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 font-outfit font-semibold text-base text-yuri-dark">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="hover:text-yuri-lilac transition-colors {% if link.active %}text-yuri-lilac underline underline-offset-4{% endif %}">
          {{ link.title }}
        </a>
      {% else %}
        <a href="/" class="hover:text-yuri-lilac transition-colors">Home</a>
        <a href="/collections/all" class="hover:text-yuri-lilac transition-colors">Shop All</a>
        <a href="/pages/about" class="hover:text-yuri-lilac transition-colors">About Us</a>
      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <a href="{{ routes.account_url }}" class="flex items-center gap-2 py-1 px-3 neo-card text-xs font-fredoka font-bold text-yuri-dark hover:bg-yuri-lilac/20 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-yuri-dark">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
            <span class="max-w-[100px] truncate">Hi, {{ customer.first_name | default: 'Account' }}</span>
          </a>
        {% else %}
          <a href="{{ routes.account_url }}" class="p-2 text-yuri-dark hover:text-yuri-lilac transition-colors" aria-label="Account">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </a>
        {% endif %}
      {% endif %}

      <a href="/search" class="p-2 text-yuri-dark hover:text-yuri-lilac transition-colors" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </a>

      <a href="/cart" class="neo-button py-1.5 px-3 text-sm flex items-center gap-2">
        <span class="font-fredoka font-bold hidden sm:inline">Cart</span>
        <span class="bg-yuri-yellow text-yuri-dark text-xs px-2 py-0.5 rounded-full border border-yuri-dark">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="MobileMenuDrawer" class="hidden md:hidden bg-white border-t-2 border-yuri-dark p-4 space-y-3 font-outfit font-semibold text-lg text-yuri-dark">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">
        {{ link.title }}
      </a>
    {% else %}
      <a href="/" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">Home</a>
      <a href="/collections/all" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">Shop All</a>
      <a href="/pages/about" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">About Us</a>
    {% endfor %}
    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_url }}" class="block py-2 px-3 rounded-xl bg-yuri-lilac/10 hover:bg-yuri-lilac/30 transition-colors text-base font-bold">
        {% if customer %}
          Hi, {{ customer.first_name | default: 'My Account' }}
        {% else %}
          Sign In / Register
        {% endif %}
      </a>
    {% endif %}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
