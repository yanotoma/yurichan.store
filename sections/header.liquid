<header class="bg-white border-b-3 border-yuri-dark shadow-[0_4px_0_#2b2b2b]">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <!-- Mobile Drawer Toggle Button -->
      <button 
        type="button" 
        class="md:hidden p-2 text-yuri-dark hover:text-yuri-lilac focus:outline-none"
        onclick="document.getElementById('MobileMenuDrawer').classList.toggle('hidden')"
        aria-label="Toggle Mobile Menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-7 h-7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <!-- Reusable Logo Component -->
      {% render 'logo', size: 'md' %}
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 font-outfit font-semibold text-base text-yuri-dark">
      <a 
        href="/collections/pet-halloween" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-[#ff7a00] text-white border-2 border-yuri-dark rounded-full font-fredoka font-bold text-xs shadow-[2px_2px_0px_#2b2b2b] hover:bg-[#ff9500] hover:shadow-[4px_4px_0px_#2b2b2b] transition-all transform hover:-translate-y-0.5"
      >
        <span>🎃 Pet Halloween</span>
      </a>
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="hover:text-yuri-lilac transition-colors {% if link.active %}text-yuri-lilac underline underline-offset-4{% endif %}">
          {{ link.title }}
        </a>
      {% else %}
        <a href="/" class="hover:text-yuri-lilac transition-colors">Home</a>
        <a href="/collections/all" class="hover:text-yuri-lilac transition-colors">Shop All</a>
        <a href="/pages/about" class="hover:text-yuri-lilac transition-colors">About Us</a>
      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <a href="{{ routes.account_url }}" class="flex items-center gap-2 py-1 px-3 neo-card text-xs font-fredoka font-bold text-yuri-dark hover:bg-yuri-lilac/20 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-yuri-dark">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
            <span class="max-w-[100px] truncate">Hi, {{ customer.first_name | default: 'Account' }}</span>
          </a>
        {% else %}
          <a href="{{ routes.account_url }}" class="p-2 text-yuri-dark hover:text-yuri-lilac transition-colors" aria-label="Account">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </a>
        {% endif %}
      {% endif %}

      <button type="button" id="open-search-modal" class="p-2 text-yuri-dark hover:text-yuri-lilac transition-colors focus:outline-none" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </button>

      <a href="/cart" class="neo-button py-1.5 px-3 text-sm flex items-center gap-2">
        <span class="font-fredoka font-bold hidden sm:inline">Cart</span>
        <span class="bg-yuri-yellow text-yuri-dark text-xs px-2 py-0.5 rounded-full border border-yuri-dark">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="MobileMenuDrawer" class="hidden md:hidden bg-white border-t-2 border-yuri-dark p-4 space-y-3 font-outfit font-semibold text-lg text-yuri-dark">
    <a 
      href="/collections/pet-halloween" 
      class="flex items-center justify-between py-2.5 px-4 rounded-xl bg-[#ff7a00] text-white border-2 border-yuri-dark font-fredoka font-bold text-base shadow-[3px_3px_0px_#2b2b2b]"
    >
      <span>🎃 Pet Halloween</span>
      <span class="text-xs bg-white text-[#ff7a00] px-2 py-0.5 rounded-full font-extrabold">NEW</span>
    </a>
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">
        {{ link.title }}
      </a>
    {% else %}
      <a href="/" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">Home</a>
      <a href="/collections/all" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">Shop All</a>
      <a href="/pages/about" class="block py-2 px-3 rounded-xl hover:bg-yuri-lilac/20 transition-colors">About Us</a>
    {% endfor %}
  </div>

  <!-- Search Modal Overlay -->
  <div 
    id="search-modal-backdrop" 
    class="fixed top-0 left-0 right-0 bottom-0 w-screen h-screen flex items-center justify-center transition-opacity duration-300 opacity-0 pointer-events-none hidden p-4" 
    style="z-index: 999999; background-color: rgba(43, 43, 43, 0.6); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);"
  >
    <div 
      id="search-modal-container"
      class="w-full max-w-lg bg-white p-6 md:p-8 flex flex-col gap-6 transform transition-all duration-300 scale-95 relative"
      style="z-index: 1000000; border: 4px solid #2b2b2b; box-shadow: 10px 10px 0px #2b2b2b; border-radius: 1.5rem;"
    >
      <!-- Title & Close Button Header -->
      <div class="flex items-center justify-between">
        <h2 class="font-fredoka font-extrabold text-2xl md:text-3xl text-yuri-dark">
          Search Products
        </h2>
        <button 
          type="button" 
          id="close-search-modal" 
          class="p-2 rounded-full border-2 border-yuri-dark bg-yuri-bg hover:bg-yuri-pink text-yuri-dark transition-colors cursor-pointer"
          aria-label="Close search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form -->
      <form action="{{ routes.search_url }}" method="get" class="flex flex-col gap-6">
        <div class="relative w-full">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 text-yuri-dark/60 absolute pointer-events-none z-10" style="left: 1.25rem; top: 50%; transform: translateY(-50%);">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
          <input 
            type="search" 
            name="q" 
            id="search-modal-input" 
            placeholder="Search cute accessories, beds, toys..." 
            class="w-full bg-yuri-bg font-fredoka font-semibold text-yuri-dark text-base placeholder-yuri-dark/40 focus:outline-none focus:bg-white transition-all border-2 border-yuri-dark rounded-xl py-3.5 pl-14 pr-4"
            autocomplete="off"
          >
        </div>
        <button 
          type="submit" 
          class="w-full bg-yuri-pink hover:bg-yuri-lilac text-yuri-dark font-fredoka font-extrabold py-3.5 text-center text-lg rounded-xl transition-all border-2 border-yuri-dark"
        >
          Search Store
        </button>
      </form>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Search Modal Logic
      const openSearchBtn = document.getElementById('open-search-modal');
      const closeSearchBtn = document.getElementById('close-search-modal');
      const searchBackdrop = document.getElementById('search-modal-backdrop');
      const searchContainer = document.getElementById('search-modal-container');
      const searchInput = document.getElementById('search-modal-input');

      function openSearchModal() {
        if (searchBackdrop.parentElement !== document.body) {
          document.body.appendChild(searchBackdrop);
        }
        searchBackdrop.classList.remove('hidden');
        void searchBackdrop.offsetWidth;
        searchBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        searchContainer.classList.remove('scale-95');
        searchContainer.classList.add('scale-100');
        document.body.classList.add('overflow-hidden');
        setTimeout(() => {
          if (searchInput) searchInput.focus();
        }, 150);
      }

      function closeSearchModal() {
        searchBackdrop.classList.add('opacity-0', 'pointer-events-none');
        searchContainer.classList.remove('scale-100');
        searchContainer.classList.add('scale-95');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
          searchBackdrop.classList.add('hidden');
        }, 300);
      }

      if (openSearchBtn) openSearchBtn.addEventListener('click', openSearchModal);
      if (closeSearchBtn) closeSearchBtn.addEventListener('click', closeSearchModal);
      if (searchBackdrop) {
        searchBackdrop.addEventListener('click', (e) => {
          if (e.target === searchBackdrop) closeSearchModal();
        });
      }

      // Handle esc key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !searchBackdrop.classList.contains('hidden')) {
          closeSearchModal();
        }
      });
    });
  </script>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
