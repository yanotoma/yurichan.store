<section class="max-w-7xl mx-auto px-4 py-8 md:py-12">
  <div class="mb-8">
    <span class="neo-badge text-xs uppercase mb-2">
      Collection
    </span>
    <h1 class="font-fredoka text-3xl md:text-5xl font-extrabold text-yuri-dark tracking-tight mt-1">
      {{ collection.title }}
    </h1>
    {% if collection.description != blank %}
      <div class="font-quicksand font-medium text-yuri-dark/80 max-w-2xl mt-3 text-base">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  {% paginate collection.products by 12 %}
    {% if collection.products.size > 0 %}
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {% for product in collection.products %}
          {% render 'product-card', card_product: product %}
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="flex items-center justify-center gap-2 mt-12 font-fredoka font-bold">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="neo-button text-sm py-2 px-4">← Prev</a>
          {% endif %}

          <span class="neo-card py-2 px-4 text-sm text-yuri-dark">
            Page {{ paginate.current_page }} of {{ paginate.pages }}
          </span>

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="neo-button text-sm py-2 px-4">Next →</a>
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      <div class="neo-card p-12 text-center bg-white space-y-4 max-w-md mx-auto my-12">
        <span class="text-4xl">😿</span>
        <h2 class="font-fredoka font-bold text-2xl text-yuri-dark">No products found</h2>
        <p class="font-quicksand text-yuri-dark/70 text-sm">There are currently no products available in this collection.</p>
        <a href="/collections/all" class="neo-button text-sm py-2 px-4 inline-block mt-2">
          View All Products
        </a>
      </div>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection Product Grid",
  "settings": []
}
{% endschema %}
