<section class="max-w-7xl mx-auto px-4 py-8 md:py-12">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-start">
    
    <!-- Gallery Section -->
    <div class="flex flex-col gap-4">
      <div class="neo-card overflow-hidden bg-white p-2">
        {% if product.featured_media %}
          <img 
            id="ProductFeaturedImage-{{ section.id }}"
            src="{{ product.featured_media | image_url: width: 800 }}" 
            alt="{{ product.featured_media.alt | escape }}"
            class="w-full h-auto object-cover rounded-xl"
            loading="eager"
          >
        {% else %}
          <div class="w-full aspect-square bg-yuri-lilac/20 rounded-xl flex items-center justify-center text-yuri-dark/50">
            No image available
          </div>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="grid grid-cols-4 sm:grid-cols-5 gap-3">
          {% for media in product.media %}
            <button 
              type="button"
              class="neo-card p-1 cursor-pointer transition-transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-yuri-lilac {% if forloop.first %}ring-2 ring-yuri-dark{% endif %}"
              onclick="document.getElementById('ProductFeaturedImage-{{ section.id }}').src='{{ media | image_url: width: 800 }}'"
            >
              <img 
                src="{{ media | image_url: width: 150 }}" 
                alt="{{ media.alt | escape }}"
                class="w-full aspect-square object-cover rounded-lg"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info Section -->
    <div class="flex flex-col gap-6">
      <div>
        {% if product.vendor %}
          <span class="neo-badge text-xs uppercase mb-2">{{ product.vendor }}</span>
        {% endif %}
        <h1 class="font-fredoka text-3xl md:text-4xl font-bold text-yuri-dark tracking-wide mt-1">
          {{ product.title }}
        </h1>
      </div>

      <!-- Price -->
      <div class="flex items-center gap-3 font-fredoka text-2xl md:text-3xl font-bold">
        <span class="text-yuri-dark">
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="text-yuri-dark/40 line-through text-lg">
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
          <span class="neo-badge bg-yuri-pink text-xs px-2 py-0.5">Sale</span>
        {% endif %}
      </div>

      <!-- Form -->
      {% form 'product', product, id: 'AddToCartForm', class: 'flex flex-col gap-6 mt-2' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {% unless product.has_only_default_variant %}
          <div class="flex flex-col gap-4">
            {% for option in product.options_with_values %}
              <div class="flex flex-col gap-2">
                <label class="font-fredoka font-semibold text-sm text-yuri-dark uppercase tracking-wider">
                  {{ option.name }}
                </label>
                <div class="flex flex-wrap gap-2">
                  {% for value in option.values %}
                    <label class="cursor-pointer">
                      <input 
                        type="radio" 
                        name="options[{{ option.name }}]" 
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        class="peer sr-only"
                      >
                      <span class="inline-block font-fredoka font-semibold text-sm px-4 py-2 rounded-full border-2 border-yuri-dark shadow-[2px_2px_0px_#2b2b2b] bg-white text-yuri-dark transition-all peer-checked:bg-yuri-lilac peer-checked:translate-x-[-1px] peer-checked:translate-y-[-1px] peer-checked:shadow-[4px_4px_0px_#2b2b2b] hover:bg-yuri-lilac/20">
                        {{ value }}
                      </span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <!-- Quantity & Add to Cart -->
        <div class="flex flex-col sm:flex-row gap-4 mt-2">
          <div class="flex items-center neo-card px-3 py-1 self-start sm:self-auto">
            <button 
              type="button" 
              class="font-fredoka font-bold text-xl px-2 text-yuri-dark hover:text-yuri-lilac"
              onclick="let q = this.nextElementSibling; if(q.value > 1) q.value--;"
            >-</button>
            <input 
              type="number" 
              name="quantity" 
              value="1" 
              min="1" 
              class="w-12 text-center font-fredoka font-bold text-lg bg-transparent border-none focus:outline-none text-yuri-dark"
            >
            <button 
              type="button" 
              class="font-fredoka font-bold text-xl px-2 text-yuri-dark hover:text-yuri-lilac"
              onclick="let q = this.previousElementSibling; q.value++;"
            >+</button>
          </div>

          <button 
            type="submit" 
            name="add"
            class="neo-button flex-1 py-3 text-lg font-bold w-full"
            {% unless product.available %}disabled{% endunless %}
          >
            {% if product.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>
      {% endform %}

      <!-- Description -->
      {% if product.description != blank %}
        <div class="neo-card p-6 mt-4 bg-white">
          <h2 class="font-fredoka font-bold text-xl text-yuri-dark mb-3">Description</h2>
          <div class="prose max-w-none text-yuri-dark/90 leading-relaxed font-quicksand">
            {{ product.description }}
          </div>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
