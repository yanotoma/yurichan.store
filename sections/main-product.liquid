<section class="max-w-7xl mx-auto px-4 py-8 md:py-12" id="ProductSection-{{ section.id }}">
  <!-- Top Grid: Gallery Carousel (Left) & Purchasing Info (Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- Gallery Carousel Section (Left: 7 cols on lg) -->
    <div class="lg:col-span-7 flex flex-col gap-4">
      <div class="neo-card overflow-hidden bg-white p-3 relative group">
        <!-- Main Carousel Viewport -->
        <div class="relative w-full aspect-square bg-yuri-bg rounded-xl overflow-hidden">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div 
                class="product-slide absolute inset-0 w-full h-full transition-opacity duration-300 {% unless forloop.first %}opacity-0 pointer-events-none{% else %}opacity-100 z-10{% endunless %}"
                data-media-index="{{ forloop.index0 }}"
              >
                <img 
                  src="{{ media | image_url: width: 1000 }}" 
                  alt="{{ media.alt | default: product.title | escape }}"
                  class="w-full h-full object-cover"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              </div>
            {% endfor %}
          {% else %}
            <div class="w-full h-full flex items-center justify-center text-yuri-dark/40 font-fredoka">
              No Image Available
            </div>
          {% endif %}

          {% if product.media.size > 1 %}
            <!-- Previous Button -->
            <button 
              type="button" 
              class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 neo-button p-2.5 rounded-full z-20 shadow-[2px_2px_0px_#2b2b2b]"
              aria-label="Previous Slide"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
              </svg>
            </button>

            <!-- Next Button -->
            <button 
              type="button" 
              class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 neo-button p-2.5 rounded-full z-20 shadow-[2px_2px_0px_#2b2b2b]"
              aria-label="Next Slide"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          {% endif %}
        </div>
      </div>

      <!-- Single Row Scrollable Thumbnail Strip -->
      {% if product.media.size > 1 %}
        <div class="flex items-center gap-3 overflow-x-auto pb-2 scrollbar-thin no-scrollbar">
          {% for media in product.media %}
            <button 
              type="button"
              class="carousel-thumb neo-card p-1 shrink-0 w-16 sm:w-20 cursor-pointer transition-transform hover:scale-105 focus:outline-none {% if forloop.first %}ring-3 ring-yuri-dark bg-yuri-lilac/30{% endif %}"
              data-thumb-index="{{ forloop.index0 }}"
            >
              <img 
                src="{{ media | image_url: width: 200 }}" 
                alt="{{ media.alt | default: product.title | escape }}"
                class="w-full aspect-square object-cover rounded-lg"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Purchasing Info Section (Right: 5 cols on lg) -->
    <div class="lg:col-span-5 flex flex-col gap-6">
      <div>
        {% if product.vendor %}
          <span class="neo-badge text-xs uppercase mb-2">{{ product.vendor }}</span>
        {% endif %}
        <h1 class="font-fredoka text-3xl md:text-4xl font-extrabold text-yuri-dark tracking-tight mt-1">
          {{ product.title }}
        </h1>
      </div>

      <!-- Price -->
      <div class="flex items-center gap-3 font-fredoka text-3xl font-bold" id="ProductPrice-{{ section.id }}">
        <span class="text-yuri-dark price-regular">
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        <span class="text-yuri-dark/40 line-through text-xl price-compare {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}hidden{% endunless %}">
          {{ product.selected_or_first_available_variant.compare_at_price | money }}
        </span>
        <span class="neo-badge bg-yuri-pink text-xs px-2.5 py-1 price-badge {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}hidden{% endunless %}">
          Sale
        </span>
      </div>

      <!-- Purchasing Form -->
      {% form 'product', product, id: 'AddToCartForm', class: 'flex flex-col gap-6 mt-2' %}
        <input type="hidden" name="id" id="VariantId-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id }}">

        {% unless product.has_only_default_variant %}
          <div class="flex flex-col gap-5">
            {% for option in product.options_with_values %}
              <div class="flex flex-col gap-2 option-group" data-option-index="{{ forloop.index0 }}">
                <label class="font-fredoka font-semibold text-sm text-yuri-dark uppercase tracking-wider">
                  {{ option.name }}: <span class="selected-value text-yuri-dark/70 font-normal">{{ option.selected_value }}</span>
                </label>
                <div class="flex flex-wrap gap-2.5">
                  {% for value in option.values %}
                    <label class="cursor-pointer">
                      <input 
                        type="radio" 
                        name="options[{{ option.name }}]" 
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        class="peer sr-only variant-option-input"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                      >
                      <span class="inline-block font-fredoka font-semibold text-sm px-4 py-2 rounded-full border-2 border-yuri-dark shadow-[2px_2px_0px_#2b2b2b] bg-white text-yuri-dark transition-all peer-checked:bg-yuri-lilac peer-checked:translate-x-[-1px] peer-checked:translate-y-[-1px] peer-checked:shadow-[4px_4px_0px_#2b2b2b] hover:bg-yuri-lilac/20">
                        {{ value }}
                      </span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <!-- Quantity & Add to Cart -->
        <div class="flex flex-col sm:flex-row gap-4 mt-2">
          <div class="flex items-center neo-card px-3 py-1 self-start sm:self-auto">
            <button 
              type="button" 
              class="font-fredoka font-bold text-xl px-2 text-yuri-dark hover:text-yuri-lilac"
              onclick="let q = this.nextElementSibling; if(q.value > 1) q.value--;"
            >-</button>
            <input 
              type="number" 
              name="quantity" 
              value="1" 
              min="1" 
              class="w-12 text-center font-fredoka font-bold text-lg bg-transparent border-none focus:outline-none text-yuri-dark"
            >
            <button 
              type="button" 
              class="font-fredoka font-bold text-xl px-2 text-yuri-dark hover:text-yuri-lilac"
              onclick="let q = this.previousElementSibling; q.value++;"
            >+</button>
          </div>

          <button 
            type="submit" 
            name="add"
            id="AddToCartBtn-{{ section.id }}"
            class="neo-button flex-1 py-3.5 text-lg font-bold w-full disabled:opacity-50 disabled:cursor-not-allowed"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            <span class="btn-text">
              {% if product.selected_or_first_available_variant.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </span>
          </button>
        </div>
      {% endform %}
    </div>

  </div>

  <!-- Wide Full-Width Description Section Below -->
  {% if product.description != blank %}
    <div class="mt-12 md:mt-16">
      <div class="neo-card p-6 md:p-10 bg-white">
        <span class="neo-badge text-xs uppercase mb-3">
          Product Details
        </span>
        <h2 class="font-fredoka font-extrabold text-2xl md:text-3xl text-yuri-dark mb-6">
          Description
        </h2>
        <div class="prose max-w-none text-yuri-dark/90 leading-relaxed font-outfit text-base md:text-lg space-y-4">
          {{ product.description }}
        </div>
      </div>
    </div>
  {% endif %}
</section>

<!-- Variant Selection & Carousel Controller Script -->
<script>
  (function() {
    const variants = {{ product.variants | json }};
    const sectionId = "{{ section.id }}";
    const sectionContainer = document.getElementById(`ProductSection-${sectionId}`);
    if (!sectionContainer) return;

    const variantIdInput = document.getElementById(`VariantId-${sectionId}`);
    const addToCartBtn = document.getElementById(`AddToCartBtn-${sectionId}`);
    const priceContainer = document.getElementById(`ProductPrice-${sectionId}`);
    
    const slides = sectionContainer.querySelectorAll('.product-slide');
    const thumbs = sectionContainer.querySelectorAll('.carousel-thumb');
    const prevBtn = sectionContainer.querySelector('.carousel-prev');
    const nextBtn = sectionContainer.querySelector('.carousel-next');
    let currentIndex = 0;
    const totalSlides = slides.length;

    function goToSlide(index) {
      if (totalSlides === 0) return;
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('opacity-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'pointer-events-none');
        }
      });

      thumbs.forEach((thumb, i) => {
        if (i === currentIndex) {
          thumb.classList.add('ring-3', 'ring-yuri-dark', 'bg-yuri-lilac/30');
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          thumb.classList.remove('ring-3', 'ring-yuri-dark', 'bg-yuri-lilac/30');
        }
      });
    }

    if (prevBtn) prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));

    thumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        const idx = parseInt(thumb.getAttribute('data-thumb-index'), 10);
        goToSlide(idx);
      });
    });

    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function getSelectedOptions() {
      const selected = [];
      const optionGroups = sectionContainer.querySelectorAll('.option-group');
      optionGroups.forEach(group => {
        const checkedRadio = group.querySelector('input[type="radio"]:checked');
        if (checkedRadio) {
          selected.push(checkedRadio.value);
          const labelSpan = group.querySelector('.selected-value');
          if (labelSpan) labelSpan.textContent = checkedRadio.value;
        }
      });
      return selected;
    }

    function findMatchingVariant(selectedOptions) {
      return variants.find(variant => {
        return variant.options.every((optionValue, index) => {
          return selectedOptions[index] === optionValue;
        });
      });
    }

    function updateVariantUI(variant) {
      if (!variant) {
        if (addToCartBtn) {
          addToCartBtn.disabled = true;
          addToCartBtn.querySelector('.btn-text').textContent = 'Unavailable';
        }
        return;
      }

      if (variantIdInput) variantIdInput.value = variant.id;

      if (priceContainer) {
        const regularPriceSpan = priceContainer.querySelector('.price-regular');
        const comparePriceSpan = priceContainer.querySelector('.price-compare');
        const saleBadgeSpan = priceContainer.querySelector('.price-badge');

        if (regularPriceSpan) regularPriceSpan.textContent = formatMoney(variant.price);

        if (variant.compare_at_price > variant.price) {
          if (comparePriceSpan) {
            comparePriceSpan.textContent = formatMoney(variant.compare_at_price);
            comparePriceSpan.classList.remove('hidden');
          }
          if (saleBadgeSpan) saleBadgeSpan.classList.remove('hidden');
        } else {
          if (comparePriceSpan) comparePriceSpan.classList.add('hidden');
          if (saleBadgeSpan) saleBadgeSpan.classList.add('hidden');
        }
      }

      if (variant.featured_image && variant.featured_image.src) {
        const matchingSlideIndex = Array.from(slides).findIndex(slide => {
          const img = slide.querySelector('img');
          return img && img.src.includes(variant.featured_image.src.split('?')[0]);
        });
        if (matchingSlideIndex !== -1) {
          goToSlide(matchingSlideIndex);
        }
      }

      if (addToCartBtn) {
        if (variant.available) {
          addToCartBtn.disabled = false;
          addToCartBtn.querySelector('.btn-text').textContent = 'Add to Cart';
        } else {
          addToCartBtn.disabled = true;
          addToCartBtn.querySelector('.btn-text').textContent = 'Sold Out';
        }
      }

      if (history.replaceState) {
        const newUrl = window.location.protocol + '//' + window.location.host + window.location.pathname + '?variant=' + variant.id;
        window.history.replaceState({ path: newUrl }, '', newUrl);
      }
    }

    const radioInputs = sectionContainer.querySelectorAll('.variant-option-input');
    radioInputs.forEach(radio => {
      radio.addEventListener('change', function() {
        const selectedOptions = getSelectedOptions();
        const matchingVariant = findMatchingVariant(selectedOptions);
        updateVariantUI(matchingVariant);
      });
    });

  })();
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
