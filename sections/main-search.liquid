<section class="max-w-7xl mx-auto px-4 py-8 md:py-12">
  <div class="max-w-2xl mx-auto text-center space-y-4 mb-10">
    <span class="neo-badge text-xs uppercase">
      Search
    </span>
    <h1 class="font-fredoka text-3xl md:text-5xl font-extrabold text-yuri-dark tracking-tight">
      Search Our Store
    </h1>

    <form action="{{ routes.search_url }}" method="get" class="flex gap-2">
      <input 
        type="search" 
        name="q" 
        value="{{ search.terms | escape }}"
        placeholder="Search beds, toys, jackets..."
        class="neo-card flex-1 py-3 px-4 text-base font-outline text-yuri-dark focus:outline-none focus:ring-2 focus:ring-yuri-lilac"
      >
      <button type="submit" class="neo-button py-3 px-6 text-base font-bold">
        Search
      </button>
    </form>
  </div>

  {% if search.performed %}
    {% if search.results_count > 0 %}
      <p class="font-fredoka font-bold text-lg text-yuri-dark mb-6 text-center">
        Found {{ search.results_count }} results for "{{ search.terms }}"
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', card_product: item %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="neo-card p-12 text-center bg-white space-y-4 max-w-md mx-auto my-8">
        <h2 class="font-fredoka font-bold text-2xl text-yuri-dark">No results found</h2>
        <p class="font-outline text-yuri-dark/70 text-sm">No items matched your search for "{{ search.terms }}". Try searching for something else!</p>
        <a href="/collections/all" class="neo-button text-sm py-2.5 px-6 inline-block mt-2">
          Browse All Products
        </a>
      </div>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
