<section class="max-w-4xl mx-auto px-4 py-8 md:py-12">
  <h1 class="font-fredoka text-3xl md:text-5xl font-extrabold text-yuri-dark mb-8 text-center sm:text-left">
    Your Shopping Cart
  </h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="space-y-8">
      <div class="space-y-4">
        {% for item in cart.items %}
          <div class="neo-card p-4 bg-white flex flex-col sm:flex-row items-center gap-4 sm:gap-6 justify-between">
            <div class="flex items-center gap-4 w-full sm:w-auto">
              <a href="{{ item.url }}" class="shrink-0 w-20 h-20 rounded-xl border-2 border-yuri-dark overflow-hidden bg-yuri-bg">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
                {% endif %}
              </a>
              <div class="space-y-1">
                <a href="{{ item.url }}" class="font-fredoka font-bold text-lg text-yuri-dark hover:underline">
                  {{ item.product.title }}
                </a>
                {% unless item.product.has_only_default_variant %}
                  <p class="font-quicksand text-xs font-semibold text-yuri-dark/60">
                    {{ item.variant.title }}
                  </p>
                {% endunless %}
                <p class="font-fredoka font-bold text-sm text-yuri-dark sm:hidden">
                  {{ item.final_price | money }}
                </p>
              </div>
            </div>

            <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-yuri-dark/10">
              <div class="flex items-center neo-card px-2 py-0.5 bg-yuri-bg">
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="font-fredoka font-bold px-2 text-yuri-dark">-</a>
                <span class="font-fredoka font-bold px-2 text-sm text-yuri-dark">{{ item.quantity }}</span>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="font-fredoka font-bold px-2 text-yuri-dark">+</a>
              </div>

              <span class="font-fredoka font-bold text-lg text-yuri-dark hidden sm:inline-block min-w-[5rem] text-right">
                {{ item.final_line_price | money }}
              </span>

              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-yuri-dark/40 hover:text-yuri-pink transition-colors p-1" title="Remove">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Subtotal & Checkout Card -->
      <div class="neo-card p-6 bg-white space-y-4">
        <div class="flex items-center justify-between text-xl font-fredoka font-bold text-yuri-dark">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="font-quicksand text-xs font-medium text-yuri-dark/60 text-right">
          Taxes and shipping calculated at checkout
        </p>

        <div class="pt-2 space-y-4">
          <button type="submit" name="checkout" class="neo-button text-lg py-3.5 px-8 w-full bg-yuri-yellow hover:bg-yuri-yellow/90">
            Proceed to Checkout
          </button>

          {% if additional_checkout_buttons %}
            <div class="additional-checkout-buttons neo-card p-4 bg-yuri-bg w-full">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {% endif %}
        </div>
      </div>
    </form>
  {% else %}
    <div class="neo-card p-12 text-center bg-white space-y-4 max-w-md mx-auto my-12">
      <h2 class="font-fredoka font-bold text-2xl text-yuri-dark">Your cart is empty</h2>
      <p class="font-quicksand text-yuri-dark/70 text-sm">Looks like you haven't added any kawaii pet goodies yet!</p>
      <a href="/collections/all" class="neo-button text-base py-3 px-6 inline-block mt-2">
        Start Shopping
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart Items",
  "settings": []
}
{% endschema %}
