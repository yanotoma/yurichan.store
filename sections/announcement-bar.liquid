<div class="bg-yuri-yellow text-yuri-dark font-fredoka text-xs md:text-sm font-bold py-2 border-b-3 border-yuri-dark overflow-hidden relative select-none">
  {% assign block_count = section.blocks.size %}
  
  {% if block_count > 1 %}
    <!-- Marquee mode for multiple announcements -->
    <div class="flex whitespace-nowrap animate-marquee hover:[animation-play-state:paused]">
      {% for i in (1..2) %}
        <div class="flex items-center shrink-0">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <span class="inline-flex items-center px-6">
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="hover:underline">
                    {{ block.settings.text | escape }}
                  </a>
                {% else %}
                  <span>{{ block.settings.text | escape }}</span>
                {% endif %}
              </span>
              <span class="text-yuri-pink font-extrabold text-base">★</span>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <!-- Single centered announcement mode (No repeat/marquee) -->
    <div class="text-center px-4">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="hover:underline">
              {{ block.settings.text | escape }}
            </a>
          {% else %}
            <span>{{ block.settings.text | escape }}</span>
          {% endif %}
        {% endif %}
      {% else %}
        <span>✨ Welcome to Yurichan Store! 🐾</span>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to Yurichan Store! 🐾",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
